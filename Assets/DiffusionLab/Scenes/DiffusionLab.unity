    GPU \u4E0A\u306E\u5B9F\u8A08\u7B97\u3067\u3059\u3002"
  - "\u6761\u4EF6\u4ED8\u304D\u5206\u5C90\u306F\u9078\u629E\u3057\u305F\u6570\u5B57\u306E
    \u03B5_c \u3092\u4E88\u6E2C\u3057\u3001\u7A7A\u6761\u4EF6\u5206\u5C90\u306F\u30AF\u30E9\u30B9\u3092\u30DE\u30B9\u30AF\u3057\u3066
