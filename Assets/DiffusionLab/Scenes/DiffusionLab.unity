  chinesePhrases:
  - "\u4E24\u4E2A\u6A21\u578B\u4F7F\u7528\u4E0D\u540C\u56FE\u50CF\u8303\u56F4\u3002Tea
    \u5728\u539F\u751F 28\xD728 \u7F51\u683C\u4E0A\u63A8\u7406\uFF0C\u8BAD\u7EC3\u50CF\u7D20\u8303\u56F4\u4E3A
    0..1\u3002Legacy \u628A MNIST \u6620\u5C04\u5230 \u22121..1\uFF0C\u5E76\u4EE5
    \u22121 \u8865\u8FB9\u5230 32\xD732\u3002\u663E\u793A\u4E3A 32\u300164 \u6216
    128 \u50CF\u7D20\u53EA\u662F\u653E\u5927\u539F\u751F\u8F93\u51FA\uFF0C\u4E0D\u80FD\u589E\u52A0\u6A21\u578B\u7EC6\u8282\u3002\u73A9\u5BB6\u5171\u4EAB\u6A21\u578B\u7248\u672C\u3001\u7C7B\u522B\u3001seed\u3001\u6B65\u6570\u548C\u8FDB\u5EA6\uFF1B\u56FE\u50CF\u53CA\u6FC0\u6D3B\u7EB9\u7406\u7531\u5404\u81EA
    GPU \u91CD\u7B97\u3002\u6D6E\u70B9\u8FD0\u7B97\u5DEE\u5F02\u4F1A\u9020\u6210\u5C11\u91CF\u50CF\u7D20\u504F\u5DEE\u3002
    Legacy \u5C06 x_0 \u88C1\u526A\u5230 \u22121..1\uFF0C\u5E76\u91CD\u7B97\u66F4\u65B0\u7528\u7684\u566A\u58F0\uFF1BTea
    \u4E0D\u88C1\u526A\u3002"
  - "Tea \u7684 U-Net \u4F9D\u6B21\u5904\u7406 28\xD728\u300114\xD714\u30017\xD77
    \u7279\u5F81\u56FE\uFF0C\u518D\u6C47\u805A\u4E3A 1\xD71 \u8868\u793A\uFF0C\u968F\u540E\u9010\u7EA7\u653E\u5927\u56DE
    28\xD728\u3002\u5728 14\xD714 \u548C 28\xD728 \u5904\uFF0C\u89E3\u7801\u5668\u901A\u8FC7
    skip \u8FDE\u63A5\u62FC\u63A5\u7F16\u7801\u5668\u7684\u540C\u5C3A\u5EA6\u7279\u5F81\uFF0C\u4FDD\u7559\u7A7A\u95F4\u7EBF\u7D22\u3002\u6BCF\u4E2A\u7B97\u5B50\u90FD\u628A\u5B9E\u9645\u7ED3\u679C\u5199\u5165\u5355\u7CBE\u5EA6
    RFloat \u7EB9\u7406\uFF0C\u5404\u901A\u9053\u5E76\u6392\u5B58\u653E\u3002\u9AD8\u4EAE\u5F53\u524D\u7B97\u5B50\u3001skip
    \u8FDE\u7EBF\u548C\u6FC0\u6D3B\u901A\u9053\uFF0C\u53EF\u8FFD\u8E2A\u771F\u5B9E\u8BA1\u7B97\u8FC7\u7A0B\u3002"
  - "\u6B63\u5411\u8FC7\u7A0B\u628A\u56FE\u50CF\u9010\u6B65\u53D8\u6210\u5E26\u566A\u72B6\u6001\uFF1Ax_t
    = \u221A\u03B1\u0304_t x_0 + \u221A(1\u2212\u03B1\u0304_t)\u03B5\uFF0C\u03B5
    \u53D6\u81EA\u6807\u51C6\u9AD8\u65AF\u5206\u5E03\u3002\u8BAD\u7EC3\u65F6\uFF0C\u6A21\u578B\u8BFB\u53D6
    x_t\u3001\u65F6\u95F4 t \u548C\u6570\u5B57\u7C7B\u522B\uFF0C\u5B66\u4E60\u9884\u6D4B
    \u03B5\u3002\u751F\u6210\u65F6\u6CA1\u6709\u5DF2\u77E5\u539F\u56FE\uFF0C\u800C\u662F\u4ECE\u9AD8\u65AF\u566A\u58F0\u5F00\u59CB\uFF0C\u53CD\u590D\u7528\u9884\u6D4B\u566A\u58F0\u4F30\u8BA1\u5E72\u51C0\u56FE
    x_0 \u548C\u4E0B\u4E00\u72B6\u6001\u3002\u9875\u9762\u4E2D\u7684\u56FE\u50CF\u4E0E\u6570\u503C\u6765\u81EA\u6A21\u578B\u6B64\u523B\u5728\u672C\u673A
    GPU \u7EB9\u7406\u4E2D\u7684\u771F\u5B9E\u8BA1\u7B97\u3002"
  - "\u6761\u4EF6\u5206\u652F\u9488\u5BF9\u6240\u9009\u6570\u5B57\u9884\u6D4B \u03B5_c\uFF1B\u7A7A\u6761\u4EF6\u5206\u652F\u5C4F\u853D\u7C7B\u522B\u540E\u9884\u6D4B
    \u03B5_null\u3002\u672C\u9879\u76EE\u7EC4\u5408\u4E3A \u03B5_guided = \u03B5_null
    + 3(\u03B5_c \u2212 \u03B5_null)\uFF0C\u7B49\u4EF7\u4E8E\u8BBA\u6587\u5199\u6CD5
    (1+w)\u03B5_c \u2212 w\u03B5_null \u4E2D\u7684 w=2\u3002\u968F\u540E\u8BA1\u7B97
    x_0 = (x_t \u2212 \u221A(1\u2212\u03B1\u0304_t)\u03B5_guided)/\u221A\u03B1\u0304_t\uFF1B\u03B7=0
    \u65F6\uFF0Cx_next = \u221A\u03B1\u0304_next x_0 + \u221A(1\u2212\u03B1\u0304_next)\u03B5_guided\uFF0C\u4E0D\u518D\u62BD\u53D6\u65B0\u566A\u58F0\u3002Tea
    \u4F7F\u7528 t=400 \u5230 1 \u7684 64 \u4E2A\u5747\u5300\u65F6\u95F4\u70B9\uFF0C\u6700\u540E\u4E00\u6B65\u76F4\u63A5\u5F97\u5230
    x_0\u3002"
  - "\u566A\u58F0\u4E0E\u56FE\u50CF\u5171\u4EAB\u540C\u4E00\u6F5C\u7A7A\u95F4\u3002\nU-Net
    \u6839\u636E CLIP \u6761\u4EF6\u9884\u6D4B\u566A\u58F0\u3002\nCFG \u7EC4\u5408\u6B63\u5411\u4E0E\u8D1F\u5411\u6761\u4EF6\u7684\u9884\u6D4B\u3002\nDDIM
    \u9010\u6B65\u6D88\u9664\u566A\u58F0\u3002\nVAE \u5C06 4 \u4E2A\u6F5C\u901A\u9053\u89E3\u7801\u4E3A
    RGB\u3002\nINT8 \u6570\u636E\u3001INT32 \u7D2F\u52A0\uFF1B\u5F52\u4E00\u5316\u4E0E
    softmax \u4F7F\u7528\u6D6E\u70B9\u3002"
  - "\u4E2D\u95F4\u56FE\u50CF\uFF1A\u7EBF\u6027\u6F5C\u53D8\u91CF\u9884\u89C8\u3002\u6700\u7EC8\u56FE\u50CF\uFF1AVAE
    \u5B9E\u9645\u89E3\u7801\u3002"
  - "\u5B9E\u65F6\u7B97\u5B50\u56FE \xB7 \u9752\u8272\uFF1A\u5F53\u524D \xB7 \u91D1\u8272\uFF1ASkip
    \xB7 \u6B63\u8D1F\u8303\u56F4 \xB13"
  - "\u4E2D\u95F4\u56FE\u50CF\uFF1A\u771F\u5B9E VAE \u9884\u89C8\u3002\u6700\u7EC8\u56FE\u50CF\uFF1A\u771F\u5B9E
    VAE \u89E3\u7801\u3002"
  - "\u7C7B\u522B\u6761\u4EF6 U-Net \xB7 DDIM \xB7 \u7247\u5143 Shader \u63A8\u7406"
  - "\u8BBE\u7F6E\u5171\u4EAB\uFF1B\u8BF7\u5728\u4E24\u6B21\u751F\u6210\u4E4B\u95F4\u7533\u8BF7\u63A7\u5236"
