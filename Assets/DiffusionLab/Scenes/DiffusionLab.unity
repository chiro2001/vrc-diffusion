    \u63A5\u7D9A\u3001\u6D3B\u6027\u5024\u30C1\u30E3\u30F3\u30CD\u30EB\u3092\u5F37\u8ABF\u3059\u308B\u3068\u8A08\u7B97\u3092\u8FFD\u3048\u307E\u3059\u3002"
  - "\u9806\u65B9\u5411\u306E\u904E\u7A0B\u3067\u306F\u3001\u753B\u50CF\u3092\u6BB5\u968E\u7684\u306B\u30CE\u30A4\u30BA\u306E\u3042\u308B\u72B6\u614B\u3078\u5909\u63DB\u3057\u307E\u3059\u3002\u5F0F\u306F
    x_t = \u221A\u03B1\u0304_t x_0 + \u221A(1\u2212\u03B1\u0304_t)\u03B5 \u3067\u3001\u03B5
    \u306F\u6A19\u6E96\u6B63\u898F\u5206\u5E03\u304B\u3089\u53D6\u308A\u307E\u3059\u3002\u5B66\u7FD2\u3067\u306F
